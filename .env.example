# ContextSwitch Backend Environment
# Copy this file to .env and fill in values

# Server
PORT=5000
NODE_ENV=production

# MongoDB
MONGO_URI=mongodb://localhost:27017/contextswitch

# AI (Optional - only needed for Google Gemini Cloud AI mode)
# AI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash
