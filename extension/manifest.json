{
  "manifest_version": 3,
  "name": "ContextSwitch — AI Context & Session Recovery",
  "version": "1.0.0",
  "description": "AI-powered browser extension that remembers work sessions, detects context switching, and lets you resume work instantly.",
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "activeTab",
    "alarms"
  ],
  "action": {
    "default_title": "Open ContextSwitch Side Panel",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "extension/sidepanel/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
